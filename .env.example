NODE_ENV=development
DEPLOYMENT_ENV=production
# Test servers only: SHA-256 of a separately shared random test login passcode.
TEST_LOGIN_SECRET_HASH=
API_PORT=3000
DATABASE_URL=postgresql://construction:construction@localhost:5432/construction_personnel?schema=public
JWT_ACCESS_TOKEN_SECRET=replace-with-at-least-32-character-jwt-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Independent 32-byte encryption key, encoded as 64 hexadecimal characters. Back it up securely.
PERSONNEL_ENCRYPTION_KEY=
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
# Development only: when "true" (and NODE_ENV is not production), /auth/wechat/login treats the
# submitted code as the openid, bypassing the WeChat exchange. Must be false/absent in production.
WECHAT_DEV_LOGIN=false
# Comma-separated allowed CORS origins (e.g. the H5 preview origin). Empty disables CORS.
CORS_ALLOWED_ORIGINS=
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=construction-personnel
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
FACE_DEV_STUB=false
UPLOADS_DIR=./var/uploads
FACE_SERVICE_BASE_URL=http://localhost:8000
FACE_SERVICE_API_KEY=replace-with-face-service-key
# VIDEO_ACTION uses GetActionSequence + LivenessCompare; no RuleId or ID card is needed.
# WECHAT_NATIVE requires an approved native Mini Program RuleId for uploaded baseline photos.
# Select the provider explicitly; secrets remain on the server and FACE_DEV_STUB must be false.
TENCENT_FACE_MODE=VIDEO_ACTION
TENCENT_FACE_REGION=ap-guangzhou
TENCENT_FACE_RULE_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
