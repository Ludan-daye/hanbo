generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  SYSTEM_ADMIN
  COMPANY_ADMIN
  PROJECT_ADMIN
  TEAM_LEADER
  WORKER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProfileOwnerType {
  WORKER
  MANAGER
}

enum ProjectStatus {
  PREPARING
  ACTIVE
  SUSPENDED
  COMPLETED
}

enum MemberStatus {
  ACTIVE
  EXITED
  SUSPENDED
}

enum AttendancePointCode {
  SEGMENT_1_START
  SEGMENT_1_END
  SEGMENT_2_START
  SEGMENT_2_END
}

enum AttendanceRecordSource {
  DEVICE
  MAKEUP
}

enum AttendanceRecordStatus {
  VALID
  INVALID
}

enum MakeupStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BindingInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum UserRoleScopeType {
  GLOBAL
  COMPANY
  PROJECT
  TEAM
}

enum MemberHistoryEvent {
  BASELINE
  CREATED
  UPDATED
}

enum ReportExportScope {
  COMPANY
  PROJECT
  TEAM
}

enum ReportExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  authoredAttendancePlans    AttendancePlan[]
  id                         String                    @id @default(uuid())
  openid                     String                    @unique
  unionid                    String?                   @unique
  phone                      String?
  encryptedRealName          String?
  nickname                   String?
  avatarObjectKey            String?
  avatarContentType          String?
  status                     UserStatus                @default(ACTIVE)
  sessionVersion             Int                       @default(1)
  isBound                    Boolean                   @default(false)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  lastLoginAt                DateTime?
  roles                      UserRole[]
  sessions                   UserSession[]
  workerProfile              WorkerProfile?
  managerProfile             ManagerProfile?
  requestedMakeups           MakeupRequest[]           @relation("requester")
  approvedMakeups            MakeupRequest[]           @relation("approver")
  createdBindingInvitations  BindingInvitation[]       @relation("bindingInvitationCreator")
  acceptedBindingInvitations BindingInvitation[]       @relation("bindingInvitationAcceptor")
  auditLogs                  AuditLog[]
  faceLivenessTests          FaceLivenessTestSession[]
  faceVerificationSessions   FaceVerificationSession[]
  uploadedFiles              StoredFile[]
  reportExports              ReportExport[]
  projectEvaluations         ProjectMemberEvaluation[]

  @@map("users")
}

model WorkerProfile {
  id                    String                @id @default(uuid())
  userId                String?               @unique
  encryptedName         String
  nameSearchHashes      String[]              @default([])
  encryptedIdNumber     String?
  idNumberHash          String?               @unique
  phone                 String
  workType              String
  realNameStatus        String
  faceProfileStatus     String
  employmentStatus      String
  emergencyContactName  String?
  emergencyContactPhone String?
  encryptedResidentialAddress String?
  hasLongTermMedication Boolean?
  encryptedMedicationDetails String?
  hasPersonalInsurance Boolean?
  encryptedInsuranceDetails String?
  encryptedPayrollBankCard String?
  registrationCompletedAt DateTime?
  remark                String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User?                 @relation(fields: [userId], references: [id])
  projectMemberships    ProjectWorkerMember[]
  bindingInvitations    BindingInvitation[]   @relation("workerBindingInvitations")

  @@index([phone])
  @@index([nameSearchHashes], type: Gin)
  @@index([employmentStatus])
  @@map("worker_profiles")
}

model ManagerProfile {
  id                    String                 @id @default(uuid())
  userId                String?                @unique
  name                  String
  phone                 String
  status                String
  workType              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  remark                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User?                  @relation(fields: [userId], references: [id])
  projectMemberships    ProjectManagerMember[]
  bindingInvitations    BindingInvitation[]    @relation("managerBindingInvitations")

  @@index([phone])
  @@index([status])
  @@map("manager_profiles")
}

model Role {
  id          String           @id @default(uuid())
  code        RoleCode         @unique
  level       Int
  name        String
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  code      String           @unique
  name      String
  roles     RolePermission[]
  createdAt DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String            @id @default(uuid())
  userId    String
  roleId    String
  scopeType UserRoleScopeType
  scopeId   String
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id])
  role      Role              @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
  @@index([scopeType, scopeId])
  @@map("user_roles")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt, revokedAt])
  @@map("user_sessions")
}

model BindingInvitation {
  id               String                  @id @default(uuid())
  codeHash         String                  @unique
  targetType       ProfileOwnerType
  workerProfileId  String?
  managerProfileId String?
  createdByUserId  String
  acceptedByUserId String?
  status           BindingInvitationStatus @default(PENDING)
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime                @default(now())
  workerProfile    WorkerProfile?          @relation("workerBindingInvitations", fields: [workerProfileId], references: [id], onDelete: Restrict)
  managerProfile   ManagerProfile?         @relation("managerBindingInvitations", fields: [managerProfileId], references: [id], onDelete: Restrict)
  createdByUser    User                    @relation("bindingInvitationCreator", fields: [createdByUserId], references: [id])
  acceptedByUser   User?                   @relation("bindingInvitationAcceptor", fields: [acceptedByUserId], references: [id])

  @@index([createdByUserId, status])
  @@index([acceptedByUserId])
  @@index([targetType, workerProfileId, status])
  @@index([targetType, managerProfileId, status])
  @@map("binding_invitations")
}

model Company {
  id            String         @id @default(uuid())
  name          String
  status        String
  shortName     String?
  creditCode    String?        @unique
  contactName   String?
  contactPhone  String?
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projects      Project[]
  reportExports ReportExport[]

  @@map("companies")
}

model Project {
  attendancePlans          AttendancePlan[]
  id                       String                    @id @default(uuid())
  companyId                String
  name                     String
  code                     String?
  address                  String
  contactName              String?
  contactPhone             String?
  remark                   String?
  centerLatitude           Decimal                   @db.Decimal(10, 7)
  centerLongitude          Decimal                   @db.Decimal(10, 7)
  geofenceRadiusM          Int
  locationAccuracyLimitM   Int?
  status                   ProjectStatus
  plannedStartDate         DateTime                  @db.Date
  plannedEndDate           DateTime?                 @db.Date
  actualStartDate          DateTime?                 @db.Date
  actualEndDate            DateTime?                 @db.Date
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  company                  Company                   @relation(fields: [companyId], references: [id])
  teams                    Team[]
  workerMembers            ProjectWorkerMember[]
  managerMembers           ProjectManagerMember[]
  shifts                   Shift[]
  attendanceRecords        AttendanceRecord[]
  attendanceResults        AttendanceResult[]
  makeupRequests           MakeupRequest[]
  memberHistories          ProjectMemberHistory[]
  memberEvaluations        ProjectMemberEvaluation[]
  reportExports            ReportExport[]
  faceVerificationSessions FaceVerificationSession[]

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("projects")
}

model Team {
  id                    String                 @id @default(uuid())
  projectId             String
  name                  String
  status                String
  workType              String?
  remark                String?
  leaderWorkerMemberId  String?
  leaderManagerMemberId String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  project               Project                @relation(fields: [projectId], references: [id])
  workers               ProjectWorkerMember[]  @relation("TeamWorkerMembers")
  managerScopedMembers  ProjectManagerMember[] @relation("TeamManagerScopeMembers")
  memberRoles           ProjectMemberRole[]
  leaderWorkerMember    ProjectWorkerMember?   @relation("WorkerTeamLeadership", fields: [leaderWorkerMemberId, projectId], references: [id, projectId], onDelete: Restrict)
  leaderManagerMember   ProjectManagerMember?  @relation("ManagerTeamLeadership", fields: [leaderManagerMemberId, projectId], references: [id, projectId], onDelete: Restrict)
  memberHistories       ProjectMemberHistory[]
  reportExports         ReportExport[]

  @@unique([id, projectId])
  @@unique([projectId, name])
  @@index([projectId, status])
  @@map("teams")
}

model ProjectWorkerMember {
  id                 String                   @id @default(uuid())
  projectId          String
  workerId           String
  teamId             String?
  requiresAttendance Boolean                  @default(true)
  enteredAt          DateTime
  exitedAt           DateTime?
  projectRoleLabel   String
  status             MemberStatus
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  project            Project                  @relation(fields: [projectId], references: [id])
  worker             WorkerProfile            @relation(fields: [workerId], references: [id])
  team               Team?                    @relation("TeamWorkerMembers", fields: [teamId, projectId], references: [id, projectId])
  ledTeams           Team[]                   @relation("WorkerTeamLeadership")
  history            ProjectMemberHistory[]
  evaluation         ProjectMemberEvaluation?
  additionalRoles    ProjectMemberRole[]

  @@unique([id, projectId])
  @@unique([projectId, workerId])
  @@index([projectId, teamId, status])
  @@index([workerId, status])
  @@index([projectId, createdAt, id])
  @@map("project_worker_members")
}

model ProjectManagerMember {
  id                 String                   @id @default(uuid())
  projectId          String
  managerId          String
  roleCode           RoleCode
  teamScopeId        String?
  requiresAttendance Boolean                  @default(true)
  enteredAt          DateTime                 @default(now())
  exitedAt           DateTime?
  status             MemberStatus
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  project            Project                  @relation(fields: [projectId], references: [id])
  manager            ManagerProfile           @relation(fields: [managerId], references: [id])
  teamScope          Team?                    @relation("TeamManagerScopeMembers", fields: [teamScopeId, projectId], references: [id, projectId])
  ledTeams           Team[]                   @relation("ManagerTeamLeadership")
  history            ProjectMemberHistory[]
  evaluation         ProjectMemberEvaluation?
  additionalRoles    ProjectMemberRole[]

  @@unique([id, projectId])
  @@unique([projectId, managerId])
  @@index([projectId, roleCode, status])
  @@index([projectId, teamScopeId, status])
  @@index([managerId, status])
  @@index([projectId, createdAt, id])
  @@map("project_manager_members")
}

model ProjectMemberRole {
  id              String @id @default(uuid())
  projectId       String
  workerMemberId  String?
  managerMemberId String?
  roleCode        RoleCode
  scopeId         String
  teamId          String?
  createdAt       DateTime @default(now())
  workerMember    ProjectWorkerMember? @relation(fields: [workerMemberId, projectId], references: [id, projectId], onDelete: Cascade)
  managerMember   ProjectManagerMember? @relation(fields: [managerMemberId, projectId], references: [id, projectId], onDelete: Cascade)
  team            Team? @relation(fields: [teamId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([workerMemberId, roleCode, scopeId])
  @@unique([managerMemberId, roleCode, scopeId])
  @@index([projectId, roleCode, teamId])
  @@map("project_member_roles")
}

model Shift {
  id        String         @id @default(uuid())
  projectId String
  name      String
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  project   Project        @relation(fields: [projectId], references: [id])
  segments  ShiftSegment[]
  schedules Schedule[]

  @@index([projectId, isDefault])
  @@map("shifts")
}

model ShiftSegment {
  id             String   @id @default(uuid())
  shiftId        String
  sequence       Int
  startTime      String
  endTime        String
  lateGraceMins  Int      @default(0)
  earlyGraceMins Int      @default(0)
  createdAt      DateTime @default(now())
  shift          Shift    @relation(fields: [shiftId], references: [id])

  @@unique([shiftId, sequence])
  @@map("shift_segments")
}

model Schedule {
  id          String    @id @default(uuid())
  shiftId     String
  ownerType   String
  ownerId     String
  startsOn    DateTime  @db.Date
  endsOn      DateTime? @db.Date
  workdayMask Int       @default(127)
  createdAt   DateTime  @default(now())
  shift       Shift     @relation(fields: [shiftId], references: [id])

  @@index([shiftId, startsOn])
  @@index([ownerType, ownerId, startsOn])
  @@map("schedules")
}

model FaceProfile {
  id                   String                    @id @default(uuid())
  ownerType            ProfileOwnerType
  ownerId              String
  baselineObjectKey    String
  baselineImageHash    String
  faceServiceId        String?
  status               String
  version              Int                       @default(1)
  reviewedByUserId     String?
  reviewedAt           DateTime?
  submittedByUserId    String?
  consentedAt          DateTime?
  consentVersion       String?
  reviewReason         String?
  verificationSessions FaceVerificationSession[]
  livenessTests        FaceLivenessTestSession[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([ownerType, ownerId, status])
  @@map("face_profiles")
}

model FaceVerificationSession {
  id                 String            @id @default(uuid())
  userId             String
  projectId          String
  participantType    ProfileOwnerType
  participantId      String
  pointCode          String
  attendanceDate     DateTime          @db.Date
  faceProfileId      String
  faceProfileVersion Int
  bizToken           String?           @unique
  provider           String            @default("WECHAT_NATIVE")
  actionSequence     String?
  videoHash          String?
  providerAttempts   Int               @default(0)
  status             String
  score              Decimal?          @db.Decimal(7, 4)
  selfieObjectKey    String?
  selfieHash         String?
  providerRequestId  String?
  failureCode        String?
  expiresAt          DateTime
  verifiedAt         DateTime?
  consumedAt         DateTime?
  createdAt          DateTime          @default(now())
  faceProfile        FaceProfile       @relation(fields: [faceProfileId], references: [id])
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  attendanceRecord   AttendanceRecord?

  @@index([userId, projectId, createdAt])
  @@map("face_verification_sessions")
}

model FaceLivenessTestSession {
  id                 String      @id @default(uuid())
  userId             String
  faceProfileId      String
  faceProfileVersion Int
  actionSequence     String?
  status             String
  videoHash          String?
  score              Decimal?    @db.Decimal(7, 4)
  providerRequestId  String?
  failureCode        String?
  expiresAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime    @default(now())
  user               User        @relation(fields: [userId], references: [id])
  faceProfile        FaceProfile @relation(fields: [faceProfileId], references: [id])

  @@index([userId, createdAt])
  @@map("face_liveness_test_sessions")
}

model AttendanceRecord {
  pointLabel                String?
  id                        String                   @id @default(uuid())
  projectId                 String
  participantType           ProfileOwnerType
  participantId             String
  attendanceDate            DateTime                 @db.Date
  pointCode                 String
  source                    AttendanceRecordSource
  status                    AttendanceRecordStatus
  occurredAt                DateTime
  serverReceivedAt          DateTime                 @default(now())
  latitude                  Decimal                  @db.Decimal(10, 7)
  longitude                 Decimal                  @db.Decimal(10, 7)
  locationAccuracyM         Decimal?                 @db.Decimal(8, 2)
  geofenceDistanceM         Decimal?                 @db.Decimal(8, 2)
  selfieObjectKey           String
  sitePhotoObjectKey        String
  selfieHash                String
  sitePhotoHash             String
  faceScore                 Decimal?                 @db.Decimal(7, 4)
  facePassed                Boolean
  abnormalReason            String?
  faceVerificationSessionId String?                  @unique
  createdAt                 DateTime                 @default(now())
  project                   Project                  @relation(fields: [projectId], references: [id])
  faceVerificationSession   FaceVerificationSession? @relation(fields: [faceVerificationSessionId], references: [id], onDelete: Restrict)

  @@index([projectId, attendanceDate, participantType, participantId])
  @@index([projectId, attendanceDate, pointCode])
  @@map("attendance_records")
}

model AttendanceResult {
  id                  String           @id @default(uuid())
  projectId           String
  attendanceDate      DateTime         @db.Date
  participantType     ProfileOwnerType
  participantId       String
  workedMinutes       Int
  isLate              Boolean
  isEarlyLeave        Boolean
  isMissingPunch      Boolean
  isAbsent            Boolean
  approvedMakeupCount Int              @default(0)
  abnormalRecordCount Int              @default(0)
  calculatedAt        DateTime         @default(now())
  project             Project          @relation(fields: [projectId], references: [id])

  @@unique([projectId, attendanceDate, participantType, participantId])
  @@index([projectId, attendanceDate])
  @@map("attendance_results")
}

model MakeupRequest {
  pointLabel          String?
  id                  String           @id @default(uuid())
  projectId           String
  requesterUserId     String
  participantType     ProfileOwnerType
  participantId       String
  attendanceDate      DateTime         @db.Date
  pointCode           String
  requestedOccurredAt DateTime
  reason              String
  status              MakeupStatus
  approverUserId      String?
  approvalReason      String?
  approvedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  project             Project          @relation(fields: [projectId], references: [id])
  requesterUser       User             @relation("requester", fields: [requesterUserId], references: [id])
  approverUser        User?            @relation("approver", fields: [approverUserId], references: [id])

  @@index([projectId, attendanceDate, status])
  @@index([requesterUserId, status])
  @@map("makeup_requests")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json
  createdAt   DateTime @default(now())
  actorUser   User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ProjectMemberHistory {
  id                 String                @id @default(uuid())
  projectId          String
  workerMemberId     String?
  managerMemberId    String?
  teamId             String?
  event              MemberHistoryEvent
  version            Int
  status             MemberStatus
  requiresAttendance Boolean
  enteredAt          DateTime
  exitedAt           DateTime?
  projectRoleLabel   String?
  roleCode           RoleCode?
  recordedAt         DateTime              @default(now())
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workerMember       ProjectWorkerMember?  @relation(fields: [workerMemberId, projectId], references: [id, projectId], onDelete: Restrict)
  managerMember      ProjectManagerMember? @relation(fields: [managerMemberId, projectId], references: [id, projectId], onDelete: Restrict)
  team               Team?                 @relation(fields: [teamId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([workerMemberId, version])
  @@unique([managerMemberId, version])
  @@index([projectId, recordedAt])
  @@index([workerMemberId, recordedAt])
  @@index([managerMemberId, recordedAt])
  @@map("project_member_histories")
}

model ProjectMemberEvaluation {
  id              String                @id @default(uuid())
  projectId       String
  workerMemberId  String?
  managerMemberId String?
  score           Int
  comment         String?
  reviewerUserId  String
  reviewedAt      DateTime              @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workerMember    ProjectWorkerMember?  @relation(fields: [workerMemberId, projectId], references: [id, projectId], onDelete: Restrict)
  managerMember   ProjectManagerMember? @relation(fields: [managerMemberId, projectId], references: [id, projectId], onDelete: Restrict)
  reviewer        User                  @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@unique([workerMemberId, projectId])
  @@unique([managerMemberId, projectId])
  @@index([projectId, reviewedAt])
  @@index([reviewerUserId, reviewedAt])
  @@map("project_member_evaluations")
}

model StoredFile {
  id             String        @id @default(uuid())
  objectKey      String        @unique
  uploaderUserId String
  contentType    String
  sizeBytes      Int
  hash           String        @db.Char(64)
  createdAt      DateTime      @default(now())
  expiresAt      DateTime?
  deletedAt      DateTime?
  uploader       User          @relation(fields: [uploaderUserId], references: [id], onDelete: Restrict)
  reportExport   ReportExport?

  @@index([uploaderUserId, createdAt])
  @@index([expiresAt, deletedAt])
  @@map("stored_files")
}

model ReportExport {
  id                 String             @id @default(uuid())
  companyId          String
  projectId          String?
  teamId             String?
  scope              ReportExportScope
  month              DateTime           @db.Date
  version            Int                @default(1)
  calculationVersion String
  dataCutoffAt       DateTime
  requestedByUserId  String
  status             ReportExportStatus @default(PENDING)
  fileId             String?            @unique
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime           @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project            Project?           @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  team               Team?              @relation(fields: [teamId, projectId], references: [id, projectId], onDelete: Restrict)
  requestedBy        User               @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  file               StoredFile?        @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([scope, companyId, projectId, teamId, month, version])
  @@index([companyId, month, status])
  @@index([requestedByUserId, createdAt])
  @@index([status, createdAt])
  @@map("report_exports")
}

// Append-only rules preserve the schedule used by each historical attendance day.
model AttendancePlan {
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  author          User?     @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  id              String    @id @default(uuid())
  projectId       String
  scopeType       String
  scopeId         String
  authorUserId    String?
  authorRoleLevel Int
  startsOn        DateTime  @db.Date
  endsOn          DateTime? @db.Date
  inherit         Boolean   @default(false)
  name            String
  points          Json
  workdayMask     Int
  createdAt       DateTime  @default(now())

  @@index([projectId, scopeType, scopeId, startsOn, createdAt])
  @@map("attendance_plans")
}
